{
  "name": "@bench/react-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.module.css": "./src/*.module.css",
    "./generated/pages/*": "./src/generated/pages/*.tsx",
    "./generated/widgets/*.module.css": "./src/generated/widgets/*.module.css",
    "./components/*": "./src/*.tsx",
    "./widgets/*": "./src/generated/widgets/*.tsx"
  },
  "dependencies": {
    "@bench/content": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.3.1",
    "typescript": "^5.9.0"
  }
}
