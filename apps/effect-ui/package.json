{
  "name": "@bench/effect-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.ts",
    "#domain/*": "./src/domain/*.ts",
    "#queries/*": "./src/queries/*.ts"
  },
  "scripts": {
    "build:all": "vite build && vite build --ssr src/prerender.ts --outDir dist/server && node prerender.mjs",
    "start": "node ../../bench/src/static-server.ts dist/client 4104",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bench/content": "workspace:*",
    "@bench/react-ui": "workspace:*",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@33dbab6",
    "effect": "^4.1.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.0",
    "vite": "^8.4.0"
  }
}
